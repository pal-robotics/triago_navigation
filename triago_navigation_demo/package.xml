<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>triago_navigation_demo</name>
  <version>0.8.0</version>
  <description>The triago navigation demos package</description>
  <maintainer email="martina.annicelli@pal-robotics.com">Martina Annicelli</maintainer>
  <license>PAL Robotics S.L</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <build_depend condition="$PAL_DISTRO >= alum">pal_module_cmake</build_depend>
  
  <depend>geometry_msgs</depend>
  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>
  <depend>pal_nav2_behaviors</depend>
  <depend>nav2_msgs</depend>
  <depend>play_motion2_msgs</depend>
  <depend>twist_mux_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>pal_nav2_msgs</depend>

  <exec_depend>ncl_utils</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
