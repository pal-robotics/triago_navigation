<?xml version="1.0"?>
<package format="3">
  <name>triago_laser_sensors</name>
  <version>0.6.0</version>
  <description>triago-specific laser sensors launch and config files.</description>
  <author email="martina.annicelli@pal-robotics.com">Martina Annicelli</author>
  <maintainer email="martina.annicelli@pal-robotics.com">Martina Annicelli</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <build_depend condition="$PAL_DISTRO >= alum">pal_module_cmake</build_depend>

  <exec_depend>omni_base_laser_sensors</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
